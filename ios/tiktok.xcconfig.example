// TikTok App Events SDK configuration.
//
// Copy this file to `ios/tiktok.xcconfig` and fill in TIKTOK_APP_SECRET. That file is
// git-ignored so the secret never reaches the repository, and because these are build
// settings they never reach the JavaScript bundle either.
//
//   TIKTOK_APP_ID        TikTok Events Manager -> your app -> "TikTok App ID".
//   TIKTOK_APP_STORE_ID  The numeric Apple App Store ID (App Store Connect ->
//                        App Information -> Apple ID). Public: it is in the store URL.
//   TIKTOK_APP_SECRET    TikTok Events Manager -> your app -> App Secret. SECRET.
//
// Note on naming: the SDK's initializer parameter is called `accessToken`, but the SDK
// uses the value as an HMAC-SHA256 signing secret for the X-TT-Signature header and
// never sends it as a bearer token. The App Secret is the correct value for it.
//
// On CI this file is generated by the "Write TikTok App Events configuration" step in
// codemagic.yaml, from the TIKTOK_APP_SECRET secure variable.

TIKTOK_APP_ID = 7685783234327740436
TIKTOK_APP_STORE_ID = 6799746242
TIKTOK_APP_SECRET = 
